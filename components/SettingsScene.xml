<?xml version="1.0" encoding="UTF-8"?>
<component name="SettingsScene" extends="Scene">
    <interface>
        <field id="closeRequested" type="boolean" value="false" />
    </interface>

    <children>
        <!-- Background -->
        <Poster
            id="bg"
            uri="pkg:/images/FaithSaver-Splash-1920x1080.jpg"
            width="1920" height="1080"
            translation="[0,0]" />

        <!-- A simple list for settings -->
        <LabelList
            id="list"
            translation="[240, 280]"
            itemSize="[1440, 60]"
            numRows="7"
            vertFocusAnimationStyle="floatingFocus" />
    </children>
</component>
