<?xml version="1.0" encoding="UTF-8"?>
<component name="SettingsScene" extends="Scene" focusable="true">
  <children>
    <!-- Background -->
    <Poster id="bg" width="1920" height="1080" loadDisplayMode="scaleToFill" uri="pkg:/images/FaithSaver-Splash-1920x1080.jpg" />

    <!-- List area -->
    <Rectangle id="hl" translation="[96,144]" width="1680" height="72" color="0x103A57FF" opacity="1.0" />
    <Group id="menu" translation="[96,144]" />
    <Rectangle id="sepAbout" translation="[96,144]" width="1680" height="2" color="0x103A57FF" opacity="1.0" visible="false" />

    <!-- HEADER -->
    <Label id="title"
           translation="[96,72]"
           width="1728"
           height="60"
           horizAlign="left"
           vertAlign="center"
           font="font:LargeSystemFont"
           color="0x000000FF"
           text="FaithSaver Settings"
           visible="true" />
    <Rectangle id="sepHeader" translation="[96,132]" width="1680" height="2" color="0x103A57FF" opacity="1.0" visible="true" />

    <!-- Overlay host (About) -->
    <Group id="overlayHost" visible="false" />
  </children>

  <!-- Include shared logger helpers (needed by SettingsScene.brs) -->
  <script type="text/brightscript" uri="pkg:/source/logger.brs" />

  <!-- Scene script -->
  <script type="text/brightscript" uri="pkg:/components/SettingsScene.brs" />
</component>
