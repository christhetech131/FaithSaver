<?xml version="1.0" encoding="UTF-8"?>
<component name="SaverScene" extends="Scene">
  <interface>
    <field id="close" type="boolean" value="false" />
  </interface>

  <children>
    <!-- Double-buffered backgrounds (we’ll animate opacity for cross-fade) -->
    <Poster id="bgA"
            width="1920" height="1080"
            translation="[0,0]"
            loadDisplayMode="scaleToFill"
            visible="true"
            opacity="1.0" />

    <Poster id="bgB"
            width="1920" height="1080"
            translation="[0,0]"
            loadDisplayMode="scaleToFill"
            visible="false"
            opacity="0.0" />

    <!-- Rotation timer (production) -->
    <Timer id="cycler" duration="30" repeat="true" control="stop" />

    <!-- Online feed (production-only) -->
    <ImageFeedTask id="feed" />

    <!-- Cross-fade animations (A<-B and B<-A) -->
    <Animation id="fadeToA" duration="0.5" easeFunction="linear" repeat="false" control="stop">
      <FloatFieldInterpolator fieldToInterp="bgA.opacity" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" />
      <FloatFieldInterpolator fieldToInterp="bgB.opacity" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" />
    </Animation>

    <Animation id="fadeToB" duration="0.5" easeFunction="linear" repeat="false" control="stop">
      <FloatFieldInterpolator fieldToInterp="bgA.opacity" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" />
      <FloatFieldInterpolator fieldToInterp="bgB.opacity" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" />
    </Animation>
  </children>

  <script type="text/brightscript" uri="pkg:/components/SaverScene.brs" />
</component>
