<?xml version="1.0" encoding="UTF-8"?>
<component name="SettingsScene" extends="Scene">
  <interface>
    <field id="closeRequested" type="boolean" value="false" />
  </interface>

  <children>
    <Poster
      id="bg"
      uri="pkg:/images/FaithSaver-Splash-1920x1080.jpg"
      loadDisplayMode="scaleToFill"
      width="1920"
      height="1080"
      translation="[0,0]" />

    <Rectangle
      id="scrim"
      color="0x33000000"
      width="1920"
      height="1080"
      translation="[0,0]" />

    <Label
      id="header"
      translation="[60,60]"
      width="1800"
      horizAlign="left"
      color="0xFF083554"
      text="Current: (loading)" />

    <MarkupList
      id="list"
      translation="[60,140]"
      itemComponentName="SettingsRow"
      itemSize="[1800,60]"
      itemSpacing="[0,8]" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/SettingsScene.brs" />
</component>
