<?xml version="1.0" encoding="UTF-8"?>
<component name="SettingsScene" extends="Scene">
  <interface>
    <field id="close" type="boolean" alwaysNotify="true" />
    <field id="saved" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Poster id="bg" uri="pkg:/images/app-logo.png" width="1920" height="1080" loadDisplayMode="scaleToFit" />
    <Rectangle id="glass" color="0x000000" opacity="0.35" width="1200" height="800" translation="[360,140]" />

    <Label id="title" text="Category:" translation="[420,180]" font="Large" />

    <Group id="list" translation="[420,240]">
      <!-- We will create labels dynamically in BRS -->
    </Group>

    <Rectangle id="hilite" color="0xFFFFFF" opacity="0.15" width="1000" height="48" translation="[410,240]" />
    <Label id="hint" text="OK to save • Back to exit" translation="[420,980]" font="Small" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/SettingsScene.brs" />
</component>
