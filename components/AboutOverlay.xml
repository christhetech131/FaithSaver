<?xml version="1.0" encoding="UTF-8"?>
<component name="AboutOverlay" extends="Group">
  <interface>
    <field id="close" type="boolean" />
  </interface>

  <children>
    <Rectangle id="scrim" color="0x00000088" width="1920" height="1080" visible="true" />

    <Group id="panel" translation="[120,120]">
      <Rectangle id="card" width="1680" height="840" color="0xFFFFFFFF" opacity="1.0">
        <Poster id="border" width="1680" height="840" uri="" />
      </Rectangle>

      <!-- Left: LARGE text pane with wrapped paragraph -->
      <Group id="left" translation="[24,24]">
        <Label id="title"   translation="[0,0]"   width="1120" height="60"  horizAlign="left" vertAlign="center" font="Large" />
        <Label id="body"    translation="[0,80]"  width="1120" height="380" horizAlign="left" vertAlign="top" wrap="true" />
        <Rectangle id="sep" translation="[0,480]" width="1120" height="2"   color="0x223041FF" />
        <Label id="readmeLabel" translation="[0,500]" width="1120" height="40"  horizAlign="left" vertAlign="center" />
        <Label id="readmeUrl"   translation="[0,540]" width="1120" height="120" horizAlign="left" vertAlign="top" wrap="true" />
      </Group>

      <!-- Right: SMALL pane with QR + caption -->
      <Group id="right" translation="[1180,24]">
        <Poster id="qr" width="320" height="320" translation="[68,40]" uri="pkg:/images/faithsaverqr.png" />
        <Label id="qrCaption" translation="[0,380]" width="456" height="120" horizAlign="center" vertAlign="top" wrap="true" />
      </Group>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/components/AboutOverlay.brs" />
</component>
