<?xml version="1.0" encoding="UTF-8"?>
<component name="SaverScene" extends="Scene">
  <interface>
    <field id="close" type="boolean" value="false" />
  </interface>

  <children>
    <!-- background double buffer -->
    <Poster id="bgA" width="1920" height="1080" translation="[0,0]" loadDisplayMode="scaleToFill" />
    <Poster id="bgB" width="1920" height="1080" translation="[0,0]" loadDisplayMode="scaleToFill" visible="false" />

    <!-- rotation timer for saver mode -->
    <Timer id="cycler" duration="180" repeat="true" control="stop" />

    <!-- Online feed task (production-only behavior now) -->
    <ImageFeedTask id="feed" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/SaverScene.brs" />
</component>
