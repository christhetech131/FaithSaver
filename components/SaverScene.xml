<?xml version="1.0" encoding="UTF-8"?>
<component name="SaverScene" extends="Scene">
  <interface>
    <field id="mode" type="string" value="preview" />
    <field id="close" type="boolean" alwaysNotify="true" />
    <field id="category" type="string" />
  </interface>

  <children>
    <!-- Background image -->
    <Poster
      id="bg"
      width="1920"
      height="1080"
      translation="[0,0]"
      loadDisplayMode="scaleToFill" />

    <!-- Optional overlay for preview mode -->
    <Group id="overlay" visible="false">
      <Rectangle id="glass" width="1920" height="100" color="0x000000" opacity="0.3" />
      <Label id="title" text="FaithSaver" translation="[60,30]" font="Medium" />
      <Label id="hint" text="Press Back to exit preview" translation="[60,60]" font="Small" />
    </Group>

    <!-- Timer drives image cycling -->
    <Timer id="cycler" repeat="true" duration="15.0" />
    <!-- ImageFeedTask node -->
    <ImageFeedTask id="feed" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/SaverScene.brs" />
</component>
