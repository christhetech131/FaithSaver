<?xml version="1.0" encoding="UTF-8"?>
<component name="SaverScene" extends="Scene">
    <interface>
        <!-- Set by main.brs: "saver" or "preview" -->
        <field id="mode" type="string" value="saver" />
        <!-- Observed by main.brs to exit -->
        <field id="close" type="boolean" value="false" />
    </interface>

    <!-- Wire the BrightScript for this component -->
    <script type="text/brightscript" uri="pkg:/components/SaverScene.brs" />

    <children>
        <!-- Double-buffered backgrounds -->
        <Poster
            id="bgA"
            width="1920" height="1080"
            translation="[0,0]"
            loadDisplayMode="scaleToFill"
            visible="true" />
        <Poster
            id="bgB"
            width="1920" height="1080"
            translation="[0,0]"
            loadDisplayMode="scaleToFill"
            visible="false" />

        <!-- Rotation timer: started only in mode="saver" -->
        <Timer id="cycler" duration="180.0" repeat="true" />

        <!-- Optional feed task (no invalid fields like "type") -->
        <Task id="feed" />
    </children>
</component>
