<?xml version="1.0" encoding="UTF-8"?>
<component name="SaverScene" extends="Scene">
  <interface>
    <field id="close" type="boolean" value="false" />
    <!-- optional for logging: -->
    <field id="mode" type="string" />
  </interface>

  <children>
    <!-- Solid background (safety, prevents any “gray” bleed) -->
    <Rectangle id="bgSolid" width="1920" height="1080" color="0x000000FF" />

    <!-- Double-buffered image planes -->
    <Poster id="bgA" width="1920" height="1080" translation="[0,0]" loadDisplayMode="scaleToFill" visible="true" />
    <Poster id="bgB" width="1920" height="1080" translation="[0,0]" loadDisplayMode="scaleToFill" visible="false" />

    <!-- Rotation timer (seconds) -->
    <Timer id="cycler" duration="30" repeat="true" control="stop" />

    <!-- Online feed task -->
    <ImageFeedTask id="feed" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/SaverScene.brs" />
</component>
