<?xml version="1.0" encoding="UTF-8"?>
<component name="SaverScene" extends="Scene">
  <interface>
    <field id="mode" type="string" alwaysNotify="true" />
    <field id="close" type="boolean" />
  </interface>

  <children>
    <Poster id="bgA" width="1920" height="1080" loadDisplayMode="scaleToFill" visible="true" />
    <Poster id="bgB" width="1920" height="1080" loadDisplayMode="scaleToFill" visible="false" />

    <Label id="previewHint"
           translation="[96, 984]"
           width="1728" height="60"
           horizAlign="left" vertAlign="center"
           font="font:MediumSystemFont"
           color="0xFFFFFFFF"
           visible="false"
           text="Press UP/DOWN to cycle • BACK to exit" />

    <Timer id="cycler" repeat="true" duration="30" />
    <ImageFeedTask id="feed" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/SaverScene.brs" />
</component>
