<?xml version="1.0" encoding="UTF-8"?>
<component name="SaverScene" extends="Scene" focusable="true">
  <children>
    <!-- Double-buffered background posters -->
    <Poster id="bgA" width="1920" height="1080" loadDisplayMode="scaleToFill" visible="true" />
    <Poster id="bgB" width="1920" height="1080" loadDisplayMode="scaleToFill" visible="false" />

    <!-- Image cycler timer (SECONDS, not ms) -->
    <Timer id="cycler" repeat="true" duration="15" control="stop" />

    <!-- Online image feed task -->
    <ImageFeedTask id="feed" control="stop" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/SaverScene.brs" />
</component>
