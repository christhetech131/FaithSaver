<?xml version="1.0" encoding="UTF-8"?>
<component name="PreviewScene" extends="Scene">
  <interface>
    <field id="closeRequested" type="boolean" value="false" />
  </interface>

  <children>
    <!-- background poster so preview doesn't look blank -->
    <Poster id="bg"
            uri="pkg:/images/FaithSaver-Splash-h-1920x1080.jpg"
            width="1920" height="1080"
            loadDisplayMode="scaleToFill"
            translation="[0,0]" />

    <Label id="title"
           translation="[60, 60]"
           width="1800"
           text="FaithSaver Preview (offline images)"
           color="0xFFFFFFFF" />

    <Label id="hint"
           translation="[60, 120]"
           width="1800"
           text="UP/DOWN to change image • BACK/HOME to exit"
           color="0xFFAAAAAA" />

    <Poster id="img"
            width="1920" height="1080"
            loadDisplayMode="scaleToFill"
            translation="[0,0]" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/PreviewScene.brs" />
</component>
